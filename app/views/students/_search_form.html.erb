<%= form_with(url: students_path, method: :get, local: true, class: "form-inline") do |form| %>
  <%= form.label :major, "Major" %>
  <%= form.select :major, options_for_select(Student::VALID_MAJORS), name: 'search[major]', class: "form-control" %>

  <%= form.label :name, "Name" %>
  <%= form.text_field :name, name: 'search[name]', class: "form-control", placeholder: "Enter student name" %>
  <%= form.submit "Search" %>
<% end %>